{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netra.ai/schemas/netra-bundle.schema.json",
  "title": "Netra relocatable kernel bundle",
  "type": "object",
  "required": ["format", "profile", "profile_revision", "target", "wave_size", "runtime_root", "artifacts", "integrations"],
  "properties": {
    "format": {"const": "netra-bundle-1"},
    "profile": {"type": "string", "minLength": 1},
    "profile_revision": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "wave_size": {"type": "integer", "minimum": 1},
    "runtime_root": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "filename", "kind", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "minLength": 1},
          "kind": {"enum": ["code_object", "runtime_library", "data"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "integrations": {"type": "object"}
  },
  "additionalProperties": false
}
