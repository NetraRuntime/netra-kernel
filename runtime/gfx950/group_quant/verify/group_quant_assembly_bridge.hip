// SPDX-License-Identifier: MIT
// Module management and caller-stream dispatch only. All computation is in
// fixed gfx950 assembly code objects generated by the Netra compiler.
#include "runtime/gfx950/group_quant/verify/group_quant_assembly_bridge.h"

#include <array>
#include <cmath>
#include <cstdio>
#include <cstring>
#include <mutex>

namespace {

constexpr uint32_t kWidthAddNorm = 5120;
constexpr uint32_t kWidthSilu = 17408;
constexpr uint32_t kWidthGated = 128;
constexpr uint32_t kGatedHeads = 48;
constexpr uint32_t kSiluGroupsPerGrid = 34;
constexpr float kInvFp8Max = 1.0f / 448.0f;
constexpr float kExactAddNormEpsilon = 1.0e-6f;
constexpr std::array<uint32_t, 13> kTokenRows = {
    8, 16, 32, 64, 128, 256, 512, 640, 768, 896, 1024, 1280, 1536};
constexpr std::array<uint32_t, 13> kGatedRows = {
    384, 768, 1536, 3072, 6144, 12288, 24576,
    30720, 36864, 43008, 49152, 61440, 73728};

constexpr const char* kAddNormSymbol =
    "netra_add_rmsnorm_group_quant_n5120_gfx950";
constexpr const char* kSiluStoreSymbol =
    "netra_silu_mul_group_quant_n17408_store_bf16_gfx950";
constexpr const char* kSiluPrequantSymbol =
    "netra_silu_mul_group_quant_n17408_prequant_only_gfx950";
constexpr const char* kGatedRpb1Symbol =
    "netra_gated_rmsnorm_group_quant_d128_rpb1_gfx950";
constexpr const char* kGatedRpb2Symbol =
    "netra_gated_rmsnorm_group_quant_d128_rpb2_gfx950";
constexpr const char* kGatedRpb4Symbol =
    "netra_gated_rmsnorm_group_quant_d128_rpb4_gfx950";

struct ModuleFunction {
  hipModule_t module = nullptr;
  hipFunction_t function = nullptr;
};

std::mutex module_mutex;
std::array<ModuleFunction, 6> loaded{};
thread_local char last_error[512] = {};

bool supported(const std::array<uint32_t, 13>& values, uint32_t value) {
  for (const uint32_t candidate : values) {
    if (candidate == value) return true;
  }
  return false;
}

int fail(const char* operation, hipError_t error) {
  std::snprintf(last_error, sizeof(last_error), "%s: %s", operation,
                hipGetErrorString(error));
  return static_cast<int>(error);
}

int fail_message(const char* message) {
  std::snprintf(last_error, sizeof(last_error), "%s", message);
  return -1;
}

void clear_modules() {
  for (ModuleFunction& item : loaded) {
    if (item.module != nullptr) (void)hipModuleUnload(item.module);
    item = {};
  }
}

hipError_t load_one(ModuleFunction* item, const char* path, const char* symbol) {
  hipError_t error = hipModuleLoad(&item->module, path);
  if (error != hipSuccess) return error;
  return hipModuleGetFunction(&item->function, item->module, symbol);
}

bool all_nonnull(std::initializer_list<const void*> pointers) {
  for (const void* pointer : pointers) {
    if (pointer == nullptr) return false;
  }
  return true;
}

}  // namespace

extern "C" int netra_group_quant_assembly_load(
    const char* add_rmsnorm_hsaco, const char* silu_store_bf16_hsaco,
    const char* silu_prequant_only_hsaco, const char* gated_rpb1_hsaco,
    const char* gated_rpb2_hsaco, const char* gated_rpb4_hsaco) {
  const std::array<const char*, 6> paths = {
      add_rmsnorm_hsaco, silu_store_bf16_hsaco, silu_prequant_only_hsaco,
      gated_rpb1_hsaco, gated_rpb2_hsaco, gated_rpb4_hsaco};
  const std::array<const char*, 6> symbols = {
      kAddNormSymbol, kSiluStoreSymbol, kSiluPrequantSymbol,
      kGatedRpb1Symbol, kGatedRpb2Symbol, kGatedRpb4Symbol};
  for (const char* path : paths) {
    if (path == nullptr || path[0] == '\0')
      return fail_message("all group-quant HSACO paths must be nonempty");
  }

  std::lock_guard<std::mutex> guard(module_mutex);
  for (const ModuleFunction& item : loaded) {
    if (item.module != nullptr)
      return fail_message("group-quant assembly modules are already loaded");
  }
  int device = 0;
  hipError_t error = hipGetDevice(&device);
  if (error != hipSuccess) return fail("hipGetDevice", error);
  hipDeviceProp_t properties{};
  error = hipGetDeviceProperties(&properties, device);
  if (error != hipSuccess) return fail("hipGetDeviceProperties", error);
  if (std::strstr(properties.gcnArchName, "gfx950") == nullptr)
    return fail_message("group-quant assembly requires gfx950");

  for (size_t index = 0; index < loaded.size(); ++index) {
    error = load_one(&loaded[index], paths[index], symbols[index]);
    if (error != hipSuccess) {
      clear_modules();
      return fail("load group-quant assembly", error);
    }
  }
  last_error[0] = '\0';
  return 0;
}

extern "C" int netra_group_quant_assembly_unload(void) {
  std::lock_guard<std::mutex> guard(module_mutex);
  clear_modules();
  last_error[0] = '\0';
  return 0;
}

extern "C" int netra_add_rmsnorm_group_quant_n5120_launch(
    const void* input_bf16, const void* residual_bf16, const void* weight_f32,
    void* output_bf16, void* residual_out_bf16, void* output_fp8,
    void* output_scale_f32, uint32_t rows, float epsilon, hipStream_t stream) {
  if (loaded[0].function == nullptr)
    return fail_message("add+RMSNorm group-quant module is not loaded");
  if (!all_nonnull({input_bf16, residual_bf16, weight_f32, output_bf16,
                    residual_out_bf16, output_fp8, output_scale_f32}))
    return fail_message("add+RMSNorm group-quant pointers must be nonnull");
  if (!supported(kTokenRows, rows))
    return fail_message("add+RMSNorm rows are outside exact profiles");
  if (epsilon != kExactAddNormEpsilon)
    return fail_message("add+RMSNorm epsilon differs from fixed contract");

  uint32_t cols = kWidthAddNorm;
  uint32_t row_stride = kWidthAddNorm;
  uint32_t col_stride = 1;
  void* hidden_scratch = nullptr;
  void* hidden_profile = nullptr;
  void* input = const_cast<void*>(input_bf16);
  void* residual = const_cast<void*>(residual_bf16);
  void* weight = const_cast<void*>(weight_f32);
  void* arguments[] = {
      &input, &residual, &weight, &output_bf16, &residual_out_bf16,
      &output_fp8, &output_scale_f32, &rows, &cols, &row_stride, &col_stride,
      &row_stride, &col_stride, &hidden_scratch, &hidden_profile};
  const hipError_t error = hipModuleLaunchKernel(
      loaded[0].function, rows, 1, 1, 1024, 1, 1, 0, stream, arguments, nullptr);
  if (error != hipSuccess) return fail("launch add+RMSNorm group-quant", error);
  last_error[0] = '\0';
  return 0;
}

extern "C" int netra_silu_mul_group_quant_n17408_launch(
    const void* gate_up_bf16, void* output_bf16, void* output_fp8,
    void* output_scale_f32, uint32_t rows, int store_bf16,
    hipStream_t stream) {
  const size_t index = store_bf16 != 0 ? 1 : 2;
  if (loaded[index].function == nullptr)
    return fail_message("SiLU group-quant module is not loaded");
  if (!all_nonnull({gate_up_bf16, output_fp8, output_scale_f32}))
    return fail_message("SiLU group-quant pointers must be nonnull");
  if (store_bf16 != 0 && output_bf16 == nullptr)
    return fail_message("SiLU BF16 output must be nonnull when enabled");
  if (!supported(kTokenRows, rows))
    return fail_message("SiLU group-quant rows are outside exact profiles");

  void* input = const_cast<void*>(gate_up_bf16);
  void* output = output_bf16 != nullptr ? output_bf16 : input;
  uint32_t width = kWidthSilu;
  float inv_fp8_max = kInvFp8Max;
  void* hidden_scratch = nullptr;
  void* hidden_profile = nullptr;
  void* arguments[] = {&input, &output, &output_fp8, &output_scale_f32,
                       &width, &rows, &inv_fp8_max,
                       &hidden_scratch, &hidden_profile};
  const hipError_t error = hipModuleLaunchKernel(
      loaded[index].function, rows, kSiluGroupsPerGrid, 1, 64, 1, 1, 0,
      stream, arguments, nullptr);
  if (error != hipSuccess) return fail("launch SiLU group-quant", error);
  last_error[0] = '\0';
  return 0;
}

extern "C" int netra_gated_rmsnorm_group_quant_d128_launch(
    const void* input_bf16, void* output_bf16, const void* weight_f32,
    const void* gate_bf16, void* output_fp8, void* output_scale_f32,
    uint32_t rows, uint32_t gate_token_stride, uint32_t gate_head_stride,
    float epsilon, hipStream_t stream) {
  if (!all_nonnull({input_bf16, output_bf16, weight_f32, gate_bf16,
                    output_fp8, output_scale_f32}))
    return fail_message("gated RMSNorm group-quant pointers must be nonnull");
  if (!supported(kGatedRows, rows))
    return fail_message("gated RMSNorm rows are outside exact profiles");
  const uint32_t rows_per_block = rows == 384 ? 1 : (rows == 768 ? 2 : 4);
  const size_t index = rows_per_block == 1 ? 3 : (rows_per_block == 2 ? 4 : 5);
  if (loaded[index].function == nullptr)
    return fail_message("gated RMSNorm group-quant module is not loaded");

  void* input = const_cast<void*>(input_bf16);
  void* weight = const_cast<void*>(weight_f32);
  void* gate = const_cast<void*>(gate_bf16);
  uint32_t row_stride = kWidthGated;
  uint32_t heads = kGatedHeads;
  uint32_t token_rows = rows / kGatedHeads;
  float inv_fp8_max = kInvFp8Max;
  void* hidden_scratch = nullptr;
  void* hidden_profile = nullptr;
  void* arguments[] = {
      &input, &output_bf16, &weight, &gate, &output_fp8, &output_scale_f32,
      &row_stride, &row_stride, &gate_token_stride, &gate_head_stride,
      &rows, &heads, &token_rows, &epsilon, &inv_fp8_max,
      &hidden_scratch, &hidden_profile};
  const hipError_t error = hipModuleLaunchKernel(
      loaded[index].function, rows / rows_per_block, 1, 1, 64, 1, 1, 0,
      stream, arguments, nullptr);
  if (error != hipSuccess)
    return fail("launch gated RMSNorm group-quant", error);
  last_error[0] = '\0';
  return 0;
}

extern "C" const char* netra_group_quant_assembly_last_error(void) {
  return last_error;
}
