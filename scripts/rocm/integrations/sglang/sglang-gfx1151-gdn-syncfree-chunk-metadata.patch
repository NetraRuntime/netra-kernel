@@ -15,21 +15,54 @@ def prepare_lens(cu_seqlens: torch.LongTensor) -> torch.LongTensor:
 
 @tensor_cache
 def prepare_chunk_indices(
-    cu_seqlens: torch.LongTensor, chunk_size: int
+    cu_seqlens: torch.LongTensor, chunk_size: int, seq_lens_cpu=None
 ) -> torch.LongTensor:
-    indices = torch.cat(
-        [
-            torch.arange(n)
-            for n in triton.cdiv(prepare_lens(cu_seqlens), chunk_size).tolist()
-        ]
+    # SGLang already maintains authoritative host sequence lengths while
+    # scheduling. Reuse them when available: materializing prepare_lens() on the
+    # host here otherwise creates a 4-byte D2H synchronization for batch 1 and
+    # drains the entire preceding prefill chunk before the first GDN layer.
+    chunk_counts = (
+        [triton.cdiv(int(n), chunk_size) for n in seq_lens_cpu]
+        if seq_lens_cpu is not None
+        else triton.cdiv(prepare_lens(cu_seqlens), chunk_size).tolist()
     )
+    if seq_lens_cpu is not None:
+        # Build on the destination device as well. A CPU arange followed by
+        # .to(cu_seqlens) is an H2D stream barrier and merely replaces the D2H
+        # barrier above with an equally expensive synchronization.
+        per_sequence = []
+        for sequence_index, chunk_count in enumerate(chunk_counts):
+            chunk_ids = torch.arange(
+                chunk_count, device=cu_seqlens.device, dtype=cu_seqlens.dtype
+            )
+            sequence_ids = torch.full_like(chunk_ids, sequence_index)
+            per_sequence.append(torch.stack([sequence_ids, chunk_ids], 1))
+        return torch.cat(per_sequence)
+
+    indices = torch.cat([torch.arange(n) for n in chunk_counts])
     return torch.stack([indices.eq(0).cumsum(0) - 1, indices], 1).to(cu_seqlens)
 
 
 @tensor_cache
 def prepare_chunk_offsets(
-    cu_seqlens: torch.LongTensor, chunk_size: int
+    cu_seqlens: torch.LongTensor, chunk_size: int, seq_lens_cpu=None
 ) -> torch.LongTensor:
+    if seq_lens_cpu is not None:
+        # Avoid cu_seqlens.new_tensor([0]): even this four-byte H2D transfer
+        # synchronizes the active HIP stream. Scalar-valued device fills enqueue
+        # normally and preserve the existing cumulative-offset semantics.
+        counts = [cu_seqlens.new_zeros((1,))]
+        counts.extend(
+            torch.full(
+                (1,),
+                triton.cdiv(int(n), chunk_size),
+                device=cu_seqlens.device,
+                dtype=cu_seqlens.dtype,
+            )
+            for n in seq_lens_cpu
+        )
+        return torch.cat(counts).cumsum(-1)
+
     return torch.cat(
         [cu_seqlens.new_tensor([0]), triton.cdiv(prepare_lens(cu_seqlens), chunk_size)]
     ).cumsum(-1)
