{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netra.ai/schemas/netra-kernel-contract.schema.json",
  "title": "Netra fixed kernel contract",
  "type": "object",
  "required": ["id", "target", "wave_size", "operation", "graph_capture", "deterministic", "fallback"],
  "properties": {
    "id": {"type": "string", "pattern": "^nk(f)?_[0-9a-f]{24}$"},
    "target": {"const": "gfx950"},
    "wave_size": {"const": 64},
    "operation": {"type": "string", "minLength": 1},
    "launch": {"$ref": "#/$defs/launch"},
    "workspace": {"$ref": "#/$defs/workspace"},
    "graph_capture": {"type": "boolean"},
    "deterministic": {"type": "boolean"},
    "fallback": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["experiment", "verified", "accepted", "rejected"]}
  },
  "oneOf": [
    {"required": ["shape", "dtypes", "quantization", "layouts", "epilogue", "tactic", "numerical", "launch", "workspace", "maturity"]},
    {"required": ["artifact_kind", "family", "constants", "specialization", "semantics", "kernarg_size", "symbol", "launch", "workspace", "maturity"], "properties": {"artifact_kind": {"const": "raw_assembly_template"}}},
    {"required": ["artifact_kind", "tactic", "symbol", "hsaco_name", "hsaco_sha256", "kernarg_size", "arguments", "launch", "workspace", "maturity"], "properties": {"artifact_kind": {"const": "golden_external_hsaco"}}},
    {"required": ["artifact_kind", "shape", "dtypes", "quantization", "layouts", "epilogue", "numerical"], "properties": {"artifact_kind": {"const": "framework_fallback"}}}
  ],
  "$defs": {
    "launch": {"type": "object", "required": ["grid", "block", "lds_bytes", "dynamic_lds_bytes"]},
    "workspace": {"type": "object", "required": ["bytes", "alignment"], "properties": {"bytes": {"type": "integer", "minimum": 0}, "alignment": {"type": "integer", "minimum": 1}}}
  }
}
